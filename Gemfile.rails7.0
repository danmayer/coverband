# frozen_string_literal: true

source 'https://rubygems.org'

# Specify your gem's dependencies in coverband.gemspec
gemspec
gem "json", "< 3" # ActiveSupport 7.0 and Ruby 3.1-era multi_json reject JSON 3.
gem 'rails', '~>7.0.0'
gem "haml"
gem "slim"
gem "webrick"

# ActiveSupport's MemCacheStore passes positional options to ConnectionPool,
# which connection_pool 3.x turned into keyword arguments.
gem "connection_pool", "~> 2.5"

# Rack 2 requires ostruct, which Ruby 4 no longer ships as a default gem.
gem "ostruct"

# Required for Ruby 3.4+ (extracted from stdlib)
gem "cgi"

# railties 7.0 requires tsort without declaring it, and Ruby 4.1 no longer
# ships it as a default gem.
gem "tsort"
